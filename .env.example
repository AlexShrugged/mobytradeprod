# Local dev runs with zero env vars (embedded PGlite, local file store, stub
# document processor/extractor, auth disabled, open admin). On Vercel the
# permissive fallbacks are refused — the vars marked REQUIRED-ON-VERCEL must
# be set there (production and preview).

## Database (REQUIRED-ON-VERCEL — the Neon integration injects both)
# Pooled (-pooler) URL for the app; docker-compose.yml provides a local one:
# DATABASE_URL=postgres://mobytrade:mobytrade@localhost:5434/mobytrade
# Direct URL for migrations/drizzle-kit (DDL bypasses PgBouncer):
# DATABASE_URL_UNPOOLED=

## File storage (REQUIRED-ON-VERCEL — the Blob integration injects the token)
# BLOB_READ_WRITE_TOKEN=
# Explicit driver selection; inferred from the token when unset:
# STORAGE_DRIVER=blob
# Switches the dropzone to client-direct blob uploads (bypasses the
# serverless request-body cap for large entry packets):
# NEXT_PUBLIC_STORAGE_DRIVER=blob

## Document parsing (REQUIRED-ON-VERCEL)
# Set to parse documents with Reducto instead of the deterministic stub:
# REDUCTO_API_KEY=

## Tariff extractor (REQUIRED-ON-VERCEL)
# Set to extract measure proposals with Claude instead of the stub:
# ANTHROPIC_API_KEY=
# TARIFF_EXTRACTOR_MODEL=claude-opus-5
# EXTRACTOR_DEADLINE_MS=120000

## Cron (REQUIRED-ON-VERCEL — generate with `openssl rand -hex 32`)
# Bearer secret for the cron routes (GET /api/tariff-sync, GET /api/documents/sweep);
# Vercel attaches it automatically to cron invocations once set:
# CRON_SECRET=

## Clerk auth (REQUIRED-ON-VERCEL; unset locally = auth disabled)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/variance
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/variance
# Comma-separated Clerk user ids allowed into /admin and the tariff-sync
# mutations (empty or unset with Clerk on = nobody):
# SUPER_ADMIN_USER_IDS=
# Dev only: bind the seeded Waystar org to a dev-instance Clerk organization:
# SEED_CLERK_ORG_ID=

## Dev-only
# Actor name for admin decisions when Clerk is disabled:
# SUPER_ADMIN_NAME=
# PGlite data directory override (default ./.pglite):
# PGLITE_DATA_DIR=
